<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<StackPane prefHeight="600" prefWidth="900" style="-fx-background-color: #f0f0f0;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ni.edu.uam.practicahibernate.controller.LibroController">

    <VBox maxWidth="750" prefHeight="480" spacing="12" style="-fx-background-color: white;                  -fx-border-color: #cccccc;                  -fx-border-width: 1;">

        <padding>
            <Insets bottom="15" left="15" right="15" top="15" />
        </padding>

        <Label style="-fx-font-size: 18px;                       -fx-font-weight: bold;" text="Registro de Libros" />

        <!-- Formulario -->
        <GridPane hgap="10" vgap="10">

            <!-- Titulo -->
            <Label text="Título:" GridPane.columnIndex="0" GridPane.rowIndex="0" />

            <TextField fx:id="txtTitulo" prefWidth="180" promptText="Título del libro" GridPane.columnIndex="1" GridPane.rowIndex="0" />

            <!-- Autor -->
            <Label text="Autor:" GridPane.columnIndex="0" GridPane.rowIndex="1" />

            <TextField fx:id="txtAutor" promptText="Autor del libro" GridPane.columnIndex="1" GridPane.rowIndex="1" />

            <!-- Año -->
            <Label text="Año:" GridPane.columnIndex="0" GridPane.rowIndex="2" />

            <TextField fx:id="txtAnio" promptText="Año de publicación" GridPane.columnIndex="1" GridPane.rowIndex="2" />

            <!-- Precio -->
            <Label text="Precio:" GridPane.columnIndex="0" GridPane.rowIndex="3" />

            <TextField fx:id="txtPrecio" promptText="Precio del libro" GridPane.columnIndex="1" GridPane.rowIndex="3" />
         <columnConstraints>
            <ColumnConstraints />
            <ColumnConstraints />
         </columnConstraints>
         <rowConstraints>
            <RowConstraints />
            <RowConstraints />
            <RowConstraints />
            <RowConstraints />
         </rowConstraints>

        </GridPane>

        <!-- Botones -->
        <HBox spacing="10">

            <Button fx:id="btnGuardar" onAction="#guardarLibro" text="Guardar libro" />
         <Button mnemonicParsing="false" text="Modificar" />

            <Button fx:id="btnCargar" onAction="#cargarLibros" text="Cargar libros" />
         <Button mnemonicParsing="false" text="Limpiar Campos" />
         <Button mnemonicParsing="false" text="Eliminar" />

        </HBox>

        <!-- Tabla de libros -->
        <TableView fx:id="tablaLibros" VBox.vgrow="ALWAYS">

            <columns>

                <TableColumn fx:id="colId" prefWidth="60" text="ID" />

                <TableColumn fx:id="colTitulo" prefWidth="200" text="Título" />

                <TableColumn fx:id="colAutor" prefWidth="200" text="Autor" />

                <TableColumn fx:id="colAnio" prefWidth="100" text="Año" />

                <TableColumn fx:id="colPrecio" prefWidth="120" text="Precio" />

            </columns>

        </TableView>

    </VBox>

</StackPane>
