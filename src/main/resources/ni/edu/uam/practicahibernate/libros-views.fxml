<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<?import javafx.scene.text.Font?>
<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="ni.edu.uam.practicahibernate.controller.LibroController"
      alignment="TOP_CENTER"
      prefWidth="850.0"
      prefHeight="520.0"
      spacing="12.0">

    <children>

        <Label text="Registro de Libros">
            <font>
                <Font name="Times New Roman Bold" size="22.0"/>
            </font>
        </Label>

        <!-- Formulario para los datos del libro. -->
        <GridPane hgap="10.0" vgap="8.0">

            <columnConstraints>
                <ColumnConstraints minWidth="85.0"
                                   hgrow="NEVER"/>
                <ColumnConstraints hgrow="ALWAYS"/>
            </columnConstraints>

            <children>

                <Label text="Título:"/>
                <Label text="Autor:" GridPane.rowIndex="1"/>
                <Label text="Año:" GridPane.rowIndex="2"/>
                <Label text="Precio:" GridPane.rowIndex="3"/>
                <Label text="Categoría:" GridPane.rowIndex="4"/>

                <TextField fx:id="txtTitulo"
                           promptText="Título del libro"
                           GridPane.columnIndex="1"/>

                <TextField fx:id="txtAutor"
                           promptText="Autor del libro"
                           GridPane.columnIndex="1"
                           GridPane.rowIndex="1"/>

                <TextField fx:id="txtAnio"
                           promptText="Año de publicación"
                           GridPane.columnIndex="1"
                           GridPane.rowIndex="2"/>

                <TextField fx:id="txtPrecio"
                           promptText="Precio del libro"
                           GridPane.columnIndex="1"
                           GridPane.rowIndex="3"/>

                <!-- ComboBox que muestra las categorías
                     consultadas mediante CategoriaDAO. -->
                <ComboBox fx:id="cmbCategoria"
                          promptText="Seleccione una categoría"
                          maxWidth="Infinity"
                          GridPane.columnIndex="1"
                          GridPane.rowIndex="4"/>

            </children>
        </GridPane>

        <!-- Botones conectados al controlador JavaFX. -->
        <HBox alignment="CENTER" spacing="10.0">

            <children>

                <Button fx:id="btnGuardar"
                        text="Guardar Libro"
                        onAction="#guardarLibro"/>

                <Button fx:id="btnCargar"
                        text="Cargar Libros"
                        onAction="#cargarLibros"/>

                <Button fx:id="btnModificar"
                        text="Modificar Libro"
                        onAction="#modificarLibro"/>

                <Button fx:id="btnEliminar"
                        text="Eliminar Libro"
                        onAction="#eliminarLibro"/>

                <Button fx:id="btnLimpiar"
                        text="Limpiar Campos"
                        onAction="#limpiarCampos"/>

            </children>
        </HBox>

        <!-- Tabla de libros, ahora con categoría. -->
        <TableView fx:id="tblLibros"
                   VBox.vgrow="ALWAYS">

            <columns>
                <TableColumn fx:id="colId"
                             text="ID"
                             prefWidth="50.0"/>

                <TableColumn fx:id="colTitulo"
                             text="Título"
                             prefWidth="230.0"/>

                <TableColumn fx:id="colAutor"
                             text="Autor"
                             prefWidth="200.0"/>

                <TableColumn fx:id="colAnio"
                             text="Año"
                             prefWidth="70.0"/>

                <TableColumn fx:id="colPrecio"
                             text="Precio"
                             prefWidth="90.0"/>

                <!-- Nueva columna relacionada con Categoria. -->
                <TableColumn fx:id="colCategoria"
                             text="Categoría"
                             prefWidth="120.0"/>
            </columns>

            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
            </columnResizePolicy>

            <placeholder>
                <Label text="No hay libros para mostrar. Presione Cargar Libros."/>
            </placeholder>

        </TableView>

    </children>

    <padding>
        <Insets top="15.0"
                bottom="15.0"
                left="15.0"
                right="15.0"/>
    </padding>

</VBox>